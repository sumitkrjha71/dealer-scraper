# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Redis (BullMQ queue backend) ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── PostgreSQL (job state, metadata, results) ─────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealer_scraper

# ─── Browser Pool ──────────────────────────────────────────────────────────────
# How many Playwright browser instances to keep alive simultaneously
MAX_BROWSERS=3
# Max concurrent pages per browser (contexts share the browser process)
MAX_PAGES_PER_BROWSER=5
# Recycle browser after this many page uses (prevents memory accumulation)
BROWSER_RECYCLE_AFTER=50

# ─── Worker Concurrency ────────────────────────────────────────────────────────
# How many dealer-discovery jobs run in parallel (light: just pagination detection)
DEALER_WORKER_CONCURRENCY=10
# How many screenshot jobs run in parallel (heavy: each holds a browser page)
SCREENSHOT_WORKER_CONCURRENCY=20

# ─── Timeouts (milliseconds) ───────────────────────────────────────────────────
PAGE_LOAD_TIMEOUT=30000
NETWORK_IDLE_TIMEOUT=10000
SCREENSHOT_TIMEOUT=60000
# How long to wait for new content on infinite-scroll pages
INFINITE_SCROLL_WAIT_MS=3000
# Max pages to capture per dealer (safety cap, prevents runaway crawls)
MAX_PAGES_PER_DEALER=50

# ─── Retry ─────────────────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_DELAY_MS=2000

# ─── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
SCREENSHOTS_DIR=./screenshots

# S3 settings (required when STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_BUCKET=dealer-screenshots
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: custom S3-compatible endpoint (MinIO, Cloudflare R2, etc.)
S3_ENDPOINT=

# ─── Proxy (optional) ──────────────────────────────────────────────────────────
# Residential proxy recommended for Cloudflare-protected sites
# Format: http://user:pass@proxy-host:port
PROXY_URL=

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
# Per-domain request cap to avoid aggressive bot detection
REQUESTS_PER_DOMAIN_PER_MINUTE=10
